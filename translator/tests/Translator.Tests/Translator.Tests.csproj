<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Translator.Core\Translator.Core.csproj" />
    <ProjectReference Include="..\..\src\Translator.Cli\Translator.Cli.csproj" />
  </ItemGroup>

  <!-- Donor integration is opt-in; Sin's default suite has no launcher dependency. -->
  <PropertyGroup>
    <EnableDonorIntegrationTests Condition="'$(EnableDonorIntegrationTests)' == ''">false</EnableDonorIntegrationTests>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableDonorIntegrationTests)' == 'true'">
    <DefineConstants>$(DefineConstants);DONOR_INTEGRATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableDonorIntegrationTests)' == 'true'">
    <ProjectReference Include="$(RECOMP_DONOR_ROOT)\Launcher\WiiCompiled.Setup.Common\WiiCompiled.Setup.Common.csproj" />
    <Content Include="$(RECOMP_DONOR_ROOT)\translator\tests\Translator.Tests\TestAssets\RetroWfcPayload\binary\payload.RMC?D00.bin"
             Link="TestAssets\RetroWfcPayload\binary\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableDonorIntegrationTests)' != 'true'">
    <Compile Remove="RegionalRetroRewindTests.cs" />
  </ItemGroup>
  <Target Name="ValidateDonorIntegrationInputs" BeforeTargets="PrepareForBuild"
          Condition="'$(EnableDonorIntegrationTests)' == 'true'">
    <Error Condition="'$(RECOMP_DONOR_ROOT)' == ''"
           Text="Set RECOMP_DONOR_ROOT to a compatible Wiicompiled checkout before enabling donor integration tests." />
    <Error Condition="!Exists('$(RECOMP_DONOR_ROOT)\Launcher\WiiCompiled.Setup.Common\WiiCompiled.Setup.Common.csproj')"
           Text="RECOMP_DONOR_ROOT does not contain the required WiiCompiled.Setup.Common project." />
  </Target>

  <!--
    The default suite is intentionally binary-free and host-compiler-free. These
    files need either MKWii game data or a working host C++ toolchain, so they are
    excluded until they are moved into a separate asset-backed integration project.
    These seven inherited exclusions predate the Sin baseline repair. They are
    preserved, not counted as passing coverage, and are not enabled by the donor
    switch. Reintroduce them only with their required game/runtime/compiler fixtures.
  -->
  <ItemGroup>
    <Compile Remove="MtxIntegrationTests.cs" />
    <Compile Remove="CodeGenInlineCoverageTests.cs" />
    <Compile Remove="CodeGenTests.cs" />
    <Compile Remove="DolFileTests.cs" />
    <Compile Remove="BasicBlockTests.cs" />
    <Compile Remove="PpcDisassemblerTests.cs" />
    <Compile Remove="PpcRuntimeHelperTests.cs" />
  </ItemGroup>

</Project>
